# 덤프링(dumpring) 로컬 개발용 환경 설정 예시 파일
# 협업 시 이 파일을 복사하여 .env 파일을 생성한 뒤 실제 값을 채워 넣어 사용하세요.

PROJECT_NAME="덤프링 (dumpring)"
SECRET_KEY="YOUR_LOCAL_SECRET_KEY"

# 데이터베이스 연결 정보 (Supabase Connection Pooler - Transaction Mode 포트 6543 필수)
DATABASE_URL="postgresql+asyncpg://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Supabase Storage 설정
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET_NAME="dumpring-files"
